# Copy this file to .env and fill in real values. .env is gitignored —
# it is unique to your computer (or the droplet) and never committed.

# Beeswax DSP credentials
BEESWAX_EMAIL=
BEESWAX_PASSWORD=
# BEESWAX_API_BASE=https://iheartmedia.api.beeswax.com/rest/v2
# BEESWAX_LEGACY_LIST_BASE=https://iheartmedia.api.beeswax.com/rest/list_item

# Google Sheets / Drive OAuth (see credentials/ setup in HOW_TO_USE.md)
GOOGLE_OAUTH_CLIENT_SECRETS=credentials/oauth_client.json
GOOGLE_OAUTH_TOKEN_CACHE=credentials/token.json

# One Google Sheet ID per product (from each sheet's URL)
SHEET_ID_PODCAST=
SHEET_ID_STREAMING=
SHEET_ID_TOTAL_AUDIO=
SHEET_ID_MARKETPLACE_CTV=
SHEET_ID_SELECT_CTV=

# Optional
SLACK_WEBHOOK_URL=
RUNS_DIR=runs
STATE_DIR=state

# Local development only — bypasses the GitHub version-check guard.
# Never set this on the droplet or in a scheduled job.
# SBO_SKIP_GIT_GUARD=1
